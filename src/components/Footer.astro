---
import Icon from './Icon.astro';
import { navItems, site } from '../data/site';
const base = import.meta.env.BASE_URL;
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <div class="footer-logo"><img src={`${base}images/logo-full-light.png`} alt="Hutzell Aviation" width="1493" height="1379" /></div>
      <p>{site.serviceArea}.</p>
    </div>
    <div>
      <h3>Explore</h3>
      <nav aria-label="Footer navigation">
        {navItems.slice(1).map((item) => <a href={`${base}${item.href}`}>{item.label}</a>)}
        <a href={`${base}apply/`} data-renter-action data-unapproved-label="Renter Application" data-approved-label="Renter Portal" data-unapproved-href={`${base}apply/`} data-approved-href={`${base}account/`}><span data-renter-action-label>Renter Application</span></a>
      </nav>
    </div>
    <div>
      <h3>Contact</h3>
      <a href={`tel:${site.phoneHref}`}>{site.phoneDisplay} · preferred</a>
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <span>{site.location}</span><span>{site.rampLocation}</span><span>Preferred contact: {site.preferredContact}</span>
    </div>
    <div class="footer-cta">
      <h3>Ready to build time?</h3>
      <p>Review availability, submit a renter application, and prepare for the approval process.</p>
      <a href={`${base}availability/`}>View availability <Icon name="arrow" size={18} /></a>
    </div>
  </div>
  <div class="container footer-bottom">
    <p>© {new Date().getFullYear()} Hutzell Aviation LLC. All rights reserved.</p>
    <p>Aircraft rental only. All rentals are subject to approval, insurance requirements, aircraft availability, and the signed rental agreement.</p>
  </div>
</footer>
