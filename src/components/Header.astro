---
import Icon from './Icon.astro';
import { navItems, site } from '../data/site';
const base = import.meta.env.BASE_URL;
const pathname = Astro.url.pathname;
const activeFor = (href: string) => href === '' ? pathname === base || pathname === base.slice(0, -1) : pathname.includes(`/${href}`);
---
<div class="announcement">
  <div class="container announcement-inner">
    <span>Piper Cherokee rental for approved pilots and time builders</span>
    <a href={`${base}apply/`}>Apply to rent <span aria-hidden="true">→</span></a>
  </div>
</div>
<header class="site-header" data-header>
  <div class="container header-inner">
    <a class="brand" href={base} aria-label="Hutzell Aviation home">
      <span class="brand-mark-wrap"><img src={`${base}images/logo-mark.png`} alt="" width="132" height="60" /></span>
      <span class="brand-words"><strong>HUTZELL</strong><span>AVIATION</span></span>
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="primary-nav" data-nav-toggle>
      <span class="sr-only">Open navigation</span><span></span><span></span><span></span>
    </button>

    <nav class="primary-nav" id="primary-nav" aria-label="Primary navigation" data-nav>
      {navItems.map((item) => <a class:list={[{ active: activeFor(item.href) }]} href={`${base}${item.href}`}>{item.label}</a>)}
      <a class="nav-account" href={`${base}account/`}><Icon name="user" size={17} /> Account</a>
      <a class="button button-small" href={`${base}apply/`}>Apply to Rent</a>
    </nav>
  </div>
</header>
<script is:inline>
  const toggle = document.querySelector('[data-nav-toggle]');
  const nav = document.querySelector('[data-nav]');
  if (toggle && nav) {
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      nav.classList.toggle('is-open', !open);
      document.body.classList.toggle('nav-open', !open);
    });
    nav.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
      toggle.setAttribute('aria-expanded', 'false');
      nav.classList.remove('is-open');
      document.body.classList.remove('nav-open');
    }));
  }
</script>
