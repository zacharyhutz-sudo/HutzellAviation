---
import Icon from './Icon.astro';
import { navItems } from '../data/site';
const base = import.meta.env.BASE_URL;
const pathname = Astro.url.pathname;
const activeFor = (href: string) => href === '' ? pathname === base || pathname === base.slice(0, -1) : pathname.includes(`/${href}`);
---
<div class="announcement">
  <div class="container announcement-inner">
    <span>1974 Piper PA-28-140 rental at KWDR in Winder</span>
    <a href={`${base}availability/`}>View aircraft availability <span aria-hidden="true">→</span></a>
  </div>
</div>
<header class="site-header" data-header>
  <div class="container header-inner">
    <a class="brand brand-image" href={base} aria-label="Hutzell Aviation home" data-brand-link>
      <img src={`${base}images/logo-full.png`} alt="Hutzell Aviation" width="1358" height="1224" />
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="primary-nav" data-nav-toggle>
      <span class="sr-only" data-nav-label>Open navigation</span><span></span><span></span><span></span>
    </button>

    <nav class="primary-nav" id="primary-nav" aria-label="Primary navigation" data-nav>
      {navItems.map((item) => <a class:list={[{ active: activeFor(item.href) }]} aria-current={activeFor(item.href) ? 'page' : undefined} href={`${base}${item.href}`}>{item.label}</a>)}
      <details class="nav-more"><summary>More</summary><div><a href={`${base}about/`}>About Hutzell Aviation</a><a href={`${base}aircraft/#requirements`}>Renter requirements</a><a href={`${base}apply/`}>Renter application</a><a href={`mailto:tylerhutzell4@gmail.com`}>Contact Tyler</a></div></details>
      <a class="nav-admin" href={`${base}admin/`} data-admin-link hidden>Admin</a>
      <a class="button button-small" href={`${base}account/`} data-account-link><Icon name="user" size={17} /><span data-account-label>Sign In</span></a>
    </nav>
  </div>
</header>
<script>
  import { onSession, isApproved } from '../lib/session';

  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const navLabel = document.querySelector<HTMLElement>('[data-nav-label]');
  const brandLink = document.querySelector<HTMLElement>('[data-brand-link]');
  const mobileNavQuery = window.matchMedia('(max-width: 900px)');

  function setNavOpen(open: boolean, focusFirst = false) {
    if (!toggle || !nav) return;
    toggle.setAttribute('aria-expanded', String(open));
    nav.classList.toggle('is-open', open);
    document.body.classList.toggle('nav-open', open);
    if (!open) nav.querySelectorAll('details').forEach((item) => item.open = false);
    if (navLabel) navLabel.textContent = open ? 'Close navigation' : 'Open navigation';
    if (open && focusFirst) {
      window.setTimeout(() => nav.querySelector<HTMLElement>('a:not([hidden])')?.focus(), 50);
    }
  }

  if (toggle && nav) {
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      setNavOpen(open, open);
    });

    nav.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setNavOpen(false)));
    brandLink?.addEventListener('click', () => setNavOpen(false));

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setNavOpen(false);
        toggle.focus();
      }
    });

    mobileNavQuery.addEventListener('change', (event) => {
      if (!event.matches) setNavOpen(false);
    });
  }

  const more = document.querySelector<HTMLDetailsElement>('.nav-more');
  document.addEventListener('click', (event) => { if (more && !more.contains(event.target as Node)) more.open = false; });
  document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && more?.open) { more.open = false; more.querySelector('summary')?.focus(); } });

  const accountLabel = document.querySelector('[data-account-label]');
  const adminLink = document.querySelector<HTMLElement>('[data-admin-link]');
  onSession(({ loading, userId, profile }) => {
    if (loading) return;
    if (accountLabel) accountLabel.textContent = userId ? 'Renter Portal' : 'Sign In';
    if (adminLink) adminLink.hidden = profile?.role !== 'admin';
    document.querySelectorAll<HTMLElement>('[data-portal-nav]').forEach((nav) => nav.hidden = !userId);
    document.body.classList.toggle('has-portal-nav', Boolean(userId && document.querySelector('[data-portal-nav]')));
    document.querySelectorAll<HTMLElement>('[data-returning-renter]').forEach((el) => el.hidden = !userId);
    document.querySelectorAll<HTMLAnchorElement>('[data-renter-action]').forEach((link) => {
      const approved = isApproved(profile);
      const label = approved ? link.dataset.approvedLabel : link.dataset.unapprovedLabel;
      const href = approved ? link.dataset.approvedHref : link.dataset.unapprovedHref;
      const labelEl = link.querySelector<HTMLElement>('[data-renter-action-label]');
      if (label && labelEl) labelEl.textContent = label;
      if (href) link.href = href;
    });
  });
</script>
