---
import Icon from './Icon.astro';
import { navItems } from '../data/site';
const base = import.meta.env.BASE_URL;
const pathname = Astro.url.pathname;
const activeFor = (href: string) => href === '' ? pathname === base || pathname === base.slice(0, -1) : pathname.includes(`/${href}`);
---
<div class="announcement">
  <div class="container announcement-inner">
    <span>1974 Piper PA-28-140 rental at KWDR in Winder</span>
    <a href={`${base}availability/`}>View aircraft availability <span aria-hidden="true">→</span></a>
  </div>
</div>
<header class="site-header" data-header>
  <div class="container header-inner">
    <a class="brand brand-image" href={base} aria-label="Hutzell Aviation home" data-brand-link>
      <img src={`${base}images/logo-full.png`} alt="Hutzell Aviation" width="1400" height="1069" />
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="primary-nav" data-nav-toggle>
      <span class="sr-only" data-nav-label>Open navigation</span><span></span><span></span><span></span>
    </button>

    <nav class="primary-nav" id="primary-nav" aria-label="Primary navigation" data-nav>
      {navItems.map((item) => <a class:list={[{ active: activeFor(item.href) }]} href={`${base}${item.href}`}>{item.label}</a>)}
      <a class="nav-admin" href={`${base}admin/`} data-admin-link hidden>Admin</a>
      <a class="nav-account" href={`${base}account/`} data-account-link><Icon name="user" size={17} /> <span data-account-label>Account</span></a>
      <a class="button button-small" href={`${base}apply/`}>Apply to Rent</a>
    </nav>
  </div>
</header>
<script>
  import { getCurrentProfile, supabase } from '../lib/supabase';

  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const navLabel = document.querySelector<HTMLElement>('[data-nav-label]');
  const brandLink = document.querySelector<HTMLElement>('[data-brand-link]');
  const mobileNavQuery = window.matchMedia('(max-width: 900px)');

  function setNavOpen(open: boolean, focusFirst = false) {
    if (!toggle || !nav) return;
    toggle.setAttribute('aria-expanded', String(open));
    nav.classList.toggle('is-open', open);
    document.body.classList.toggle('nav-open', open);
    if (navLabel) navLabel.textContent = open ? 'Close navigation' : 'Open navigation';
    if (open && focusFirst) {
      window.setTimeout(() => nav.querySelector<HTMLElement>('a:not([hidden])')?.focus(), 50);
    }
  }

  if (toggle && nav) {
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      setNavOpen(open, open);
    });

    nav.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setNavOpen(false)));
    brandLink?.addEventListener('click', () => setNavOpen(false));

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setNavOpen(false);
        toggle.focus();
      }
    });

    mobileNavQuery.addEventListener('change', (event) => {
      if (!event.matches) setNavOpen(false);
    });
  }

  const accountLabel = document.querySelector('[data-account-label]');
  const adminLink = document.querySelector<HTMLElement>('[data-admin-link]');
  async function updateHeaderAccount() {
    try {
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) {
        if (accountLabel) accountLabel.textContent = 'Account';
        if (adminLink) adminLink.hidden = true;
        return;
      }
      const profile = await getCurrentProfile();
      if (accountLabel) accountLabel.textContent = 'Dashboard';
      if (adminLink) adminLink.hidden = profile?.role !== 'admin';
    } catch {
      if (adminLink) adminLink.hidden = true;
    }
  }
  updateHeaderAccount();
  supabase.auth.onAuthStateChange(() => { window.setTimeout(updateHeaderAccount, 0); });
</script>
