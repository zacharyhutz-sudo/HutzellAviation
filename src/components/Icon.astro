---
interface Props {
  name: 'compass' | 'certificate' | 'refresh' | 'book' | 'check' | 'arrow' | 'phone' | 'mail' | 'location' | 'clock' | 'plane';
  size?: number;
}
const { name, size = 24 } = Astro.props;
---
<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  {name === 'compass' && (
    <>
      <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8" />
      <path d="M14.8 9.2L13 13L9.2 14.8L11 11L14.8 9.2Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
    </>
  )}
  {name === 'certificate' && (
    <>
      <circle cx="12" cy="9" r="5" stroke="currentColor" stroke-width="1.8" />
      <path d="M8.5 13L7.5 21L12 18.5L16.5 21L15.5 13" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
      <path d="M10 9L11.4 10.4L14.3 7.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
    </>
  )}
  {name === 'refresh' && (
    <>
      <path d="M20 11A8 8 0 0 0 6.3 5.3L4 8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
      <path d="M4 4V8H8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
      <path d="M4 13A8 8 0 0 0 17.7 18.7L20 16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
      <path d="M20 20V16H16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
    </>
  )}
  {name === 'book' && (
    <>
      <path d="M4 5.5C6.2 4.5 8.4 4.7 12 6V20C8.4 18.7 6.2 18.5 4 19.5V5.5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
      <path d="M20 5.5C17.8 4.5 15.6 4.7 12 6V20C15.6 18.7 17.8 18.5 20 19.5V5.5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
    </>
  )}
  {name === 'check' && <path d="M5 12.5L9.5 17L19 7.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />}
  {name === 'arrow' && (
    <>
      <path d="M5 12H19" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
      <path d="M14 7L19 12L14 17" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
    </>
  )}
  {name === 'phone' && <path d="M7.2 3.5L9.7 7.8L7.9 9.7C9 12 12 15 14.3 16.1L16.2 14.3L20.5 16.8L19.4 20.3C19.2 20.8 18.7 21.1 18.1 21C10.2 19.8 4.2 13.8 3 5.9C2.9 5.3 3.2 4.8 3.7 4.6L7.2 3.5Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />}
  {name === 'mail' && (
    <>
      <rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.8" />
      <path d="M4 7L12 13L20 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
    </>
  )}
  {name === 'location' && (
    <>
      <path d="M20 10C20 16 12 21 12 21C12 21 4 16 4 10A8 8 0 1 1 20 10Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
      <circle cx="12" cy="10" r="2.5" stroke="currentColor" stroke-width="1.8" />
    </>
  )}
  {name === 'clock' && (
    <>
      <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8" />
      <path d="M12 7V12L15.5 14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
    </>
  )}
  {name === 'plane' && <path d="M2.5 13L9.5 10.5L12 3L14 2L13.5 10L20.5 8L22 9L15 13L15.5 19L14 20L11 14.5L6 17L4.5 16L7.5 13.5L2.5 13Z" fill="currentColor" />}
</svg>
