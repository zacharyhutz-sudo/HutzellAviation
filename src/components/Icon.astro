---
interface Props {
  name:
    | 'arrow'
    | 'calendar'
    | 'check'
    | 'clock'
    | 'document'
    | 'dollar'
    | 'gauge'
    | 'location'
    | 'mail'
    | 'plane'
    | 'shield'
    | 'user'
    | 'wrench';
  size?: number;
}
const { name, size = 24 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
  {name === 'arrow' && <><path d="M5 12H19" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M14 7L19 12L14 17" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></>}
  {name === 'calendar' && <><rect x="3" y="5" width="18" height="16" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="M7 3V7M17 3V7M3 10H21" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></>}
  {name === 'check' && <path d="M5 12.5L9.5 17L19 7.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>}
  {name === 'clock' && <><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8"/><path d="M12 7V12L15.5 14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></>}
  {name === 'document' && <><path d="M6 3H14L19 8V21H6V3Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M14 3V8H19M9 12H16M9 16H16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></>}
  {name === 'dollar' && <><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8"/><path d="M15 8.5C14.3 7.8 13.3 7.5 12.2 7.5C10.4 7.5 9 8.4 9 9.8C9 11.2 10.2 11.8 12.3 12.2C14.3 12.6 15.5 13.3 15.5 14.7C15.5 16.1 14.1 17 12.2 17C10.9 17 9.7 16.6 8.8 15.7M12 5.8V18.8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></>}
  {name === 'gauge' && <><path d="M4 18A8 8 0 1 1 20 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M12 14L16 10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M6.5 15.5L5.2 14.8M17.5 15.5L18.8 14.8M12 8V6.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></>}
  {name === 'location' && <><path d="M20 10C20 16 12 21 12 21C12 21 4 16 4 10A8 8 0 1 1 20 10Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><circle cx="12" cy="10" r="2.5" stroke="currentColor" stroke-width="1.8"/></>}
  {name === 'mail' && <><rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="M4 7L12 13L20 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></>}
  {name === 'plane' && <path d="M2.5 13L9.5 10.5L12 3L14 2L13.5 10L20.5 8L22 9L15 13L15.5 19L14 20L11 14.5L6 17L4.5 16L7.5 13.5L2.5 13Z" fill="currentColor"/>}
  {name === 'shield' && <><path d="M12 3L19 6V11C19 15.5 16.4 19.1 12 21C7.6 19.1 5 15.5 5 11V6L12 3Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M9 12L11 14L15.5 9.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></>}
  {name === 'user' && <><circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.8"/><path d="M4.5 21C5.2 16.9 8 15 12 15C16 15 18.8 16.9 19.5 21" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></>}
  {name === 'wrench' && <path d="M14.7 6.3A5 5 0 0 0 8.2 12.8L3.5 17.5A2.1 2.1 0 1 0 6.5 20.5L11.2 15.8A5 5 0 0 0 17.7 9.3L14.5 12.5L11.5 9.5L14.7 6.3Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>}
</svg>
