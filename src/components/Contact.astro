---
import Icon from './Icon.astro';
import { site } from '../data/site';
---
<section class="contact-section" id="contact">
  <div class="container contact-shell reveal">
    <div class="contact-copy">
      <p class="eyebrow light"><span></span> READY WHEN YOU ARE</p>
      <h2>Take the first step toward the cockpit.</h2>
      <p>Tell Tyler about your rental needs and availability. Phone is the preferred contact method, and he will follow up about approval and scheduling.</p>
      <div class="contact-actions">
        <a class="button" href={`mailto:${site.email}?subject=Aircraft%20Rental%20Inquiry`}>Email Tyler <Icon name="arrow" size={20} /></a>
        <a class="button button-ghost" href={`tel:${site.phoneHref}`}>Call {site.phoneDisplay}</a>
      </div>
    </div>
    <div class="contact-card">
      <h3>Hutzell Aviation</h3>
      <ul>
        <li><span><Icon name="phone" size={20} /></span><div><small>PHONE · PREFERRED</small><a href={`tel:${site.phoneHref}`}>{site.phoneDisplay}</a></div></li>
        <li><span><Icon name="mail" size={20} /></span><div><small>EMAIL</small><a href={`mailto:${site.email}`}>{site.email}</a></div></li>
        <li><span><Icon name="location" size={20} /></span><div><small>HOME AIRPORT</small><strong>{site.location}</strong></div></li>
      </ul>
      <p class="contact-note">Based at KWDR Barrow County Airport in Winder, tie-down spot #10. Tyler approves every reservation.</p>
    </div>
  </div>
</section>
