---
import Icon from './Icon.astro';
const base = import.meta.env.BASE_URL;
---
<section class="hero section" id="top">
  <div class="container hero-grid">
    <div class="hero-copy reveal">
      <p class="eyebrow"><span></span> FLIGHT INSTRUCTION • ATHENS, GA</p>
      <h1>Learn to fly with confidence.</h1>
      <p class="hero-lede">
        Personalized instruction for new and developing pilots—built around clear goals, consistent coaching, and a strong foundation in safety.
      </p>
      <div class="hero-actions">
        <a class="button" href="#contact">Start Your Training <Icon name="arrow" size={20} /></a>
        <a class="text-link" href="#about">Meet Tyler <Icon name="arrow" size={18} /></a>
      </div>
      <ul class="trust-list" aria-label="Training highlights">
        <li><span><Icon name="check" size={17} /></span> Certified flight instruction</li>
        <li><span><Icon name="check" size={17} /></span> One-on-one lessons</li>
        <li><span><Icon name="check" size={17} /></span> Flexible local scheduling</li>
      </ul>
    </div>

    <div class="hero-visual reveal reveal-delay">
      <div class="hero-visual-frame">
        <img src={`${base}images/hero-illustration.svg`} alt="A small airplane climbing above a runway at sunset" width="960" height="760" />
      </div>
      <div class="hero-float-card">
        <span class="float-icon"><Icon name="plane" size={23} /></span>
        <div>
          <strong>Your first lesson starts here.</strong>
          <span>No previous experience required.</span>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="proof-strip" aria-label="Hutzell Aviation advantages">
  <div class="container proof-grid">
    <div><strong>1-on-1</strong><span>Personalized instruction</span></div>
    <div><strong>Athens</strong><span>Local flight training</span></div>
    <div><strong>Flexible</strong><span>Scheduling around your goals</span></div>
    <div><strong>Focused</strong><span>Safety, skill, and confidence</span></div>
  </div>
</section>
