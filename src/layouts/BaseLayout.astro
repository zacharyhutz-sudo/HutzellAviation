---
import { site } from '../data/site';
interface Props { title?: string; description?: string; noindex?: boolean; }
const {
  title = 'Aircraft Rental in Winder, GA | Hutzell Aviation',
  description = 'Piper Cherokee aircraft rental planned at Winder–Barrow Airport (KWDR). Wet rates and time-building blocks for Northeast Georgia pilots from Atlanta to Athens.',
  noindex = false,
} = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const ogImage = new URL(`${base}images/n8491f-hero.jpg`, Astro.site ?? Astro.url.origin);
const home = new URL(base, Astro.site ?? Astro.url.origin).toString();
const businessId = `${home}#business`;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization', '@id': businessId, name: site.name,
      url: home, telephone: site.phoneHref, email: site.email,
      logo: new URL(`${base}images/logo-full.png`, home).toString(),
      image: ogImage.toString(), sameAs: [site.instagram],
      location: { '@type': 'Place', name: 'Winder–Barrow Airport (KWDR)',
        address: { '@type': 'PostalAddress', addressLocality: 'Winder', addressRegion: 'GA', addressCountry: 'US' } },
      areaServed: ['Northeast Georgia', 'Winder, GA', 'Atlanta, GA', 'Athens, GA', 'Lawrenceville, GA', 'Dacula, GA', 'Buford, GA', 'Jefferson, GA', 'Monroe, GA'].map(name => ({ '@type': 'Place', name })),
    },
    { '@type': 'WebSite', '@id': `${home}#website`, url: home, name: site.shortName, publisher: { '@id': businessId } },
    { '@type': 'WebPage', '@id': `${canonical}#webpage`, url: canonical.toString(), name: title,
      description, isPartOf: { '@id': `${home}#website` }, about: { '@id': businessId } },
    ...(Astro.url.pathname === base ? [{ '@type': 'Service', name: 'Piper PA-28-140 aircraft rental at KWDR',
      description: 'Planned wet-rate aircraft rental and prepaid time-building blocks for approved pilots at Winder–Barrow Airport in Winder, Georgia.',
      serviceType: 'Aircraft rental', provider: { '@id': businessId }, url: home }] : []),
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#082B45" />
    <link rel="icon" type="image/png" href={`${base}favicon.png`} />
    <link rel="canonical" href={canonical.toString()} />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:site_name" content={site.shortName} />
    <meta property="og:image:alt" content="Hutzell Aviation Piper Cherokee N8491F" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage.toString()} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.toString()} />
    <title>{title}</title>
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />}
    <noscript><style>.reveal { opacity: 1 !important; transform: none !important; }</style></noscript>
    <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.112.0/dist/umd/supabase.js"></script>
  </head>
  <body>
    <slot />
    <script is:inline>
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reducedMotion && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.1 });
        document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
      } else {
        document.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
