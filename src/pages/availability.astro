---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { demoAvailability } from '../lib/availability';
import '../styles/global.css';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Aircraft Availability | Hutzell Aviation" description="Preview the custom Hutzell Aviation aircraft-rental calendar for the Piper Cherokee in the Athens, Georgia area.">
  <Header />
  <main>
    <PageHero eyebrow="CUSTOM RENTAL CALENDAR" title="See when the aircraft is open." description="This interactive front-end prototype demonstrates the renter calendar. Live reservations, accounts, payments, and double-booking protection will be connected in the backend phase." />

    <section class="section calendar-section">
      <div class="container">
        <div class="prototype-banner"><Icon name="wrench" size={22}/><div><strong>Interactive prototype</strong><span>The calendar works in the browser with sample availability. It does not yet save reservations or process payments.</span></div></div>

        <div class="calendar-shell" data-rental-calendar>
          <div class="calendar-main">
            <div class="calendar-toolbar">
              <div><p class="calendar-kicker">PIPER CHEROKEE</p><h2 data-month-label>August 2026</h2></div>
              <div class="calendar-nav"><button type="button" data-prev-month aria-label="Previous month">←</button><button type="button" data-today>Today</button><button type="button" data-next-month aria-label="Next month">→</button></div>
            </div>
            <div class="calendar-legend" aria-label="Calendar legend"><span><i class="legend-dot available"></i>Available</span><span><i class="legend-dot limited"></i>Limited</span><span><i class="legend-dot reserved"></i>Reserved</span><span><i class="legend-dot maintenance"></i>Maintenance</span></div>
            <div class="calendar-weekdays" aria-hidden="true"><span>Sun</span><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span></div>
            <div class="calendar-grid" data-calendar-grid aria-live="polite"></div>
          </div>

          <aside class="slot-panel" data-slot-panel>
            <div class="slot-empty" data-slot-empty><span class="slot-icon"><Icon name="calendar" size={30}/></span><h3>Select a date</h3><p>Choose a calendar day to review available windows and the planned reservation experience.</p></div>
            <div class="slot-content" data-slot-content hidden>
              <p class="slot-eyebrow">SELECTED DATE</p><h3 data-selected-date></h3><div class="selected-status" data-selected-status></div><p data-selected-note></p>
              <div class="slot-list" data-slot-list></div>
              <div class="reservation-summary" data-reservation-summary hidden><span>Selected window</span><strong data-selected-slot></strong></div>
              <a class="button slot-action" data-slot-action href={`${base}checkout/`}>Continue to Checkout Preview</a>
              <p class="slot-disclaimer">Only approved renters will be able to confirm aircraft reservations.</p>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <section class="section calendar-explainer">
      <div class="container">
        <div class="section-heading centered reveal"><p class="eyebrow centered-eyebrow"><span></span> FINAL BOOKING FLOW <span></span></p><h2>What the connected calendar will do.</h2></div>
        <div class="calendar-feature-grid"><article class="reveal"><span><Icon name="user" size={25}/></span><h3>Check approval</h3><p>Only renters with active approval can proceed from an open time window to checkout.</p></article><article class="reveal reveal-1"><span><Icon name="clock" size={25}/></span><h3>Hold the window</h3><p>The backend will temporarily hold the selected period while payment or package authorization is completed.</p></article><article class="reveal reveal-2"><span><Icon name="shield" size={25}/></span><h3>Prevent overlap</h3><p>A database constraint—not browser code—will reject any conflicting reservation attempts.</p></article><article class="reveal reveal-3"><span><Icon name="dollar" size={25}/></span><h3>Reconcile after flight</h3><p>Tyler records actual aircraft time and applies it to the renter’s block or invoice.</p></article></div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<script is:inline define:vars={{ demoAvailability, base }}>
  const calendarRoot = document.querySelector('[data-rental-calendar]');
  if (calendarRoot) {
    const grid = calendarRoot.querySelector('[data-calendar-grid]');
    const monthLabel = calendarRoot.querySelector('[data-month-label]');
    const slotEmpty = calendarRoot.querySelector('[data-slot-empty]');
    const slotContent = calendarRoot.querySelector('[data-slot-content]');
    const selectedDateEl = calendarRoot.querySelector('[data-selected-date]');
    const selectedStatusEl = calendarRoot.querySelector('[data-selected-status]');
    const selectedNoteEl = calendarRoot.querySelector('[data-selected-note]');
    const slotList = calendarRoot.querySelector('[data-slot-list]');
    const summary = calendarRoot.querySelector('[data-reservation-summary]');
    const selectedSlotEl = calendarRoot.querySelector('[data-selected-slot]');
    const action = calendarRoot.querySelector('[data-slot-action]');
    const lookup = new Map(demoAvailability.map((item) => [item.date, item]));
    let viewDate = new Date(2026, 7, 1);
    let selectedButton = null;

    const isoDate = (year, month, day) => `${year}-${String(month + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
    const fallbackFor = (date) => {
      const day = date.getDay();
      if (day === 0) return { status: 'limited', note: 'By request', slots: ['9:00 AM–1:00 PM'] };
      return { status: 'available', slots: ['8:00 AM–12:00 PM', '1:00 PM–5:00 PM'] };
    };

    const showDate = (dateKey, button) => {
      selectedButton?.classList.remove('selected');
      button.classList.add('selected');
      selectedButton = button;
      const [year, month, day] = dateKey.split('-').map(Number);
      const date = new Date(year, month - 1, day);
      const record = lookup.get(dateKey) || fallbackFor(date);
      selectedDateEl.textContent = new Intl.DateTimeFormat('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' }).format(date);
      selectedStatusEl.className = `selected-status ${record.status}`;
      selectedStatusEl.textContent = record.status === 'available' ? 'Available' : record.status === 'limited' ? 'Limited availability' : record.status === 'reserved' ? 'Reserved' : 'Maintenance';
      selectedNoteEl.textContent = record.note || (record.status === 'available' ? 'Choose an available window below.' : 'No reservable windows are published for this date.');
      slotList.innerHTML = '';
      summary.hidden = true;
      selectedSlotEl.textContent = '';
      action.classList.toggle('is-disabled', !record.slots?.length);
      action.setAttribute('aria-disabled', String(!record.slots?.length));
      (record.slots || []).forEach((slot) => {
        const slotButton = document.createElement('button');
        slotButton.type = 'button';
        slotButton.className = 'time-slot';
        slotButton.textContent = slot;
        slotButton.addEventListener('click', () => {
          slotList.querySelectorAll('button').forEach((item) => item.classList.remove('active'));
          slotButton.classList.add('active');
          selectedSlotEl.textContent = slot;
          action.href = `${base}checkout/?date=${encodeURIComponent(dateKey)}&slot=${encodeURIComponent(slot)}`;
          summary.hidden = false;
        });
        slotList.appendChild(slotButton);
      });
      slotEmpty.hidden = true;
      slotContent.hidden = false;
    };

    const render = () => {
      grid.innerHTML = '';
      const year = viewDate.getFullYear();
      const month = viewDate.getMonth();
      monthLabel.textContent = new Intl.DateTimeFormat('en-US', { month: 'long', year: 'numeric' }).format(viewDate);
      const firstDay = new Date(year, month, 1).getDay();
      const daysInMonth = new Date(year, month + 1, 0).getDate();
      const prevDays = new Date(year, month, 0).getDate();
      for (let i = firstDay - 1; i >= 0; i--) {
        const cell = document.createElement('div'); cell.className = 'calendar-day outside'; cell.innerHTML = `<span>${prevDays - i}</span>`; grid.appendChild(cell);
      }
      for (let day = 1; day <= daysInMonth; day++) {
        const date = new Date(year, month, day);
        const key = isoDate(year, month, day);
        const record = lookup.get(key) || fallbackFor(date);
        const button = document.createElement('button');
        button.type = 'button';
        button.className = `calendar-day ${record.status}`;
        button.innerHTML = `<span class="day-number">${day}</span><span class="day-state">${record.status === 'available' ? 'Open' : record.status === 'limited' ? 'Limited' : record.status === 'reserved' ? 'Reserved' : 'Maintenance'}</span>`;
        button.setAttribute('aria-label', `${key}, ${record.status}`);
        button.addEventListener('click', () => showDate(key, button));
        grid.appendChild(button);
      }
      const total = firstDay + daysInMonth;
      const trailing = (7 - (total % 7)) % 7;
      for (let day = 1; day <= trailing; day++) { const cell = document.createElement('div'); cell.className = 'calendar-day outside'; cell.innerHTML = `<span>${day}</span>`; grid.appendChild(cell); }
    };

    calendarRoot.querySelector('[data-prev-month]').addEventListener('click', () => { viewDate = new Date(viewDate.getFullYear(), viewDate.getMonth() - 1, 1); selectedButton = null; render(); });
    calendarRoot.querySelector('[data-next-month]').addEventListener('click', () => { viewDate = new Date(viewDate.getFullYear(), viewDate.getMonth() + 1, 1); selectedButton = null; render(); });
    calendarRoot.querySelector('[data-today]').addEventListener('click', () => { viewDate = new Date(2026, 7, 1); selectedButton = null; render(); });
    action.addEventListener('click', (event) => { if (action.classList.contains('is-disabled')) event.preventDefault(); });
    render();
  }
</script>
