---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CallToAction from '../components/CallToAction.astro';
import Icon from '../components/Icon.astro';
import { pricingPlans, rentalSteps, site } from '../data/site';
import '../styles/global.css';
const base = import.meta.env.BASE_URL;
---
<BaseLayout>
  <Header />
  <main id="top">
    <section class="home-hero">
      <div class="container home-hero-grid">
        <div class="hero-copy reveal">
          <p class="eyebrow"><span></span> AIRCRAFT RENTAL • ATHENS, GEORGIA</p>
          <h1>Build time.<br /><em>Fly on your schedule.</em></h1>
          <p class="hero-lead">Flexible Piper Cherokee rental for approved pilots, commercial-pilot candidates, and local time builders.</p>
          <div class="hero-actions"><a class="button" href={`${base}availability/`}>View Availability <Icon name="calendar" size={19} /></a><a class="button button-outline" href={`${base}pricing/`}>View Rental Options</a></div>
          <div class="hero-trust"><span><Icon name="shield" size={20} /> Approved renters</span><span><Icon name="location" size={20} /> Athens area</span><span><Icon name="clock" size={20} /> Flexible blocks</span></div>
        </div>
        <div class="hero-visual reveal reveal-delay">
          <img src={`${base}images/hero-illustration.svg`} alt="A small airplane climbing above a golden horizon" width="960" height="760" />
          <div class="hero-status-card"><span class="status-dot"></span><div><strong>Availability calendar</strong><span>Preview open rental windows online</span></div></div>
        </div>
      </div>
    </section>

    <section class="proof-strip" aria-label="Hutzell Aviation rental benefits">
      <div class="container proof-grid"><div><strong>Piper</strong><span>Cherokee rental</span></div><div><strong>Online</strong><span>Availability calendar</span></div><div><strong>4</strong><span>Flexible pricing options</span></div><div><strong>Local</strong><span>Athens-area access</span></div></div>
    </section>

    <section class="section intro-section">
      <div class="container split-intro">
        <div class="section-heading reveal"><p class="eyebrow"><span></span> A RENTAL COMPANY BUILT FOR PILOTS</p><h2>More access to the airplane. Less friction around the schedule.</h2></div>
        <div class="intro-copy reveal reveal-delay"><p class="lead">Hutzell Aviation is being built as a straightforward aircraft-rental company for qualified pilots who need dependable access to a Piper Cherokee.</p><p>Renters will be able to review availability, reserve approved time blocks, purchase discounted hour packages, and keep track of their reservations and remaining hours in one place.</p><a class="text-link" href={`${base}about/`}>Why Tyler started Hutzell Aviation <Icon name="arrow" size={18} /></a></div>
      </div>
    </section>

    <section class="section feature-section">
      <div class="container">
        <div class="section-heading centered reveal"><p class="eyebrow centered-eyebrow"><span></span> DESIGNED AROUND RENTAL <span></span></p><h2>A clear path from application to flight.</h2><p>The first release will keep the process simple while making availability and account activity easy to understand.</p></div>
        <div class="feature-grid">
          <article class="feature-card reveal"><span class="feature-icon"><Icon name="calendar" size={28} /></span><h3>See open time</h3><p>Review the public calendar without exposing another renter’s personal details.</p><a href={`${base}availability/`}>Open calendar <Icon name="arrow" size={17} /></a></article>
          <article class="feature-card reveal reveal-1"><span class="feature-icon"><Icon name="document" size={28} /></span><h3>Apply once</h3><p>Submit pilot information and required documents for Tyler’s review and approval.</p><a href={`${base}apply/`}>Start application <Icon name="arrow" size={17} /></a></article>
          <article class="feature-card reveal reveal-2"><span class="feature-icon"><Icon name="dollar" size={28} /></span><h3>Choose your rate</h3><p>Fly pay as you go or purchase a 15-, 25-, or 50-hour block when pricing goes live.</p><a href={`${base}pricing/`}>Compare options <Icon name="arrow" size={17} /></a></article>
        </div>
      </div>
    </section>

    <section class="section process-section">
      <div class="container">
        <div class="section-heading reveal"><p class="eyebrow light"><span></span> HOW IT WORKS</p><h2>Four steps to the flight line.</h2></div>
        <ol class="rental-steps">{rentalSteps.map((step) => <li class="reveal"><span>{step.number}</span><h3>{step.title}</h3><p>{step.text}</p></li>)}</ol>
      </div>
    </section>

    <section class="section aircraft-preview-section">
      <div class="container aircraft-preview-grid">
        <div class="aircraft-preview-art reveal"><div class="aircraft-line-card"><span class="card-label">THE AIRCRAFT</span><svg viewBox="0 0 760 360" role="img" aria-label="Stylized Piper Cherokee airplane"><path d="M76 222H276L327 187H413L473 222H682L720 247H458L424 316H370L387 247H304L272 286H220L245 247H80L42 236L76 222Z" fill="#fff" stroke="#082B45" stroke-width="7" stroke-linejoin="round"/><path d="M334 188L350 128H382L390 187" fill="#2F6F94" stroke="#082B45" stroke-width="7" stroke-linejoin="round"/><path d="M98 249H668" stroke="#D99A2B" stroke-width="5" stroke-linecap="round"/><circle cx="300" cy="276" r="16" fill="#082B45"/><circle cx="470" cy="276" r="16" fill="#082B45"/></svg><div class="aircraft-art-meta"><span>Piper Cherokee</span><span>Single-engine land</span></div></div></div>
        <div class="aircraft-preview-copy reveal reveal-delay"><p class="eyebrow"><span></span> PIPER CHEROKEE</p><h2>A proven platform for time building and personal flying.</h2><p class="lead">The aircraft page is ready for Tyler’s exact model, avionics, operating details, rental qualifications, and a full photo gallery.</p><ul class="check-list"><li><Icon name="check" size={18} /> Public specifications</li><li><Icon name="check" size={18} /> Renter requirements</li><li><Icon name="check" size={18} /> Fuel and operating policies</li></ul><a class="button button-outline" href={`${base}aircraft/`}>Explore the Aircraft <Icon name="arrow" size={19} /></a></div>
      </div>
    </section>

    <section class="section pricing-preview-section">
      <div class="container">
        <div class="section-heading centered reveal"><p class="eyebrow centered-eyebrow"><span></span> RENTAL OPTIONS <span></span></p><h2>Choose the commitment that fits your flying.</h2><p>Final rates are intentionally marked as coming soon until Tyler confirms wet or dry pricing, meter policy, package expiration, and payment terms.</p></div>
        <div class="mini-pricing-grid">{pricingPlans.map((plan) => <article class:list={['mini-price-card','reveal',{featured: plan.badge === 'Most Popular'}]}>{plan.badge && <span class="plan-badge">{plan.badge}</span>}<h3>{plan.name}</h3><strong>{plan.hours}</strong><p>{plan.rate}</p></article>)}</div>
        <div class="center-action"><a class="button button-outline" href={`${base}pricing/`}>Compare All Options <Icon name="arrow" size={19} /></a></div>
      </div>
    </section>

    <section class="section about-preview-section">
      <div class="container about-preview-grid">
        <div class="tyler-card reveal"><div class="tyler-initials">TH</div><span>FOUNDER</span><h3>{site.owner}</h3><p>ATP-trained pilot and owner of Hutzell Aviation LLC.</p></div>
        <div class="about-preview-copy reveal reveal-delay"><p class="eyebrow"><span></span> ABOUT HUTZELL AVIATION</p><h2>Created by a pilot who understands the need for accessible flight time.</h2><p class="lead">Tyler’s aviation background helps shape a renter experience built around clear expectations, practical access, and responsible aircraft use.</p><a class="text-link" href={`${base}about/`}>Meet Tyler and read the company story <Icon name="arrow" size={18} /></a></div>
      </div>
    </section>

    <CallToAction />
  </main>
  <Footer />
</BaseLayout>
