---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import '../styles/global.css';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Reservation Payments | Hutzell Aviation" description="Online payment and prepaid-hour checkout will be added after Hutzell Aviation finalizes rental rates and policies.">
  <Header />
  <main>
    <section class="checkout-hero"><div class="container"><p class="eyebrow light"><span></span> RESERVATION PAYMENTS</p><h1>Booking is live. Online payments are next.</h1><p>Approved renters can now request open aircraft time from the live calendar. Stripe payments and prepaid-hour packages will be connected after rates and billing policies are finalized.</p></div></section>
    <section class="section checkout-section"><div class="container"><div class="checkout-form-card payment-roadmap"><Icon name="calendar" size={34}/><h2>Request time through the calendar</h2><p>The calendar checks live reservations and aircraft blocks, verifies renter approval, and saves conflict-free requests to Supabase.</p><div class="account-actions"><a class="button" href={`${base}availability/`}>View Availability</a><a class="button button-outline" href={`${base}account/`}>Open Renter Account</a></div></div></div></section>
  </main>
  <Footer />
</BaseLayout>
