---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import '../styles/global.css';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Rental Billing | Hutzell Aviation" description="Hutzell Aviation renter billing, prepaid block-hour balances, and post-flight reconciliation.">
  <Header />
  <main>
    <section class="checkout-hero"><div class="container"><p class="eyebrow light"><span></span> RENTER BILLING</p><h1>Flight balances now live in your renter account.</h1><p>Prepaid 15-, 25-, and 50-hour packages are tracked against actual finalized aircraft time. If a flight exceeds your eligible prepaid balance, the remainder appears as a pay-as-you-go charge.</p></div></section>
    <section class="section checkout-section"><div class="container"><div class="checkout-form-card payment-roadmap"><Icon name="dollar" size={34}/><h2>Secure online checkout is available to approved renters.</h2><p>Sign in to your approved Hutzell Aviation renter account to purchase a 15-, 25-, or 50-hour prepaid block or pay an outstanding flight charge. The site verifies your account with Supabase before creating a one-time Stripe Checkout Session.</p><div class="account-actions"><a class="button" href={`${base}account/#purchase-hours`}>Open Renter Portal</a><a class="button button-outline" href={`${base}availability/`}>Schedule a Flight</a></div></div></div></section>
  </main>
  <Footer />
</BaseLayout>
