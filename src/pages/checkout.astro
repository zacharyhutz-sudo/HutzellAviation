---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Hours & Payments | Hutzell Aviation" noindex>
  <Header /><main class="container session-notice"><h1>Hours &amp; Payments</h1><p>Opening the payment section in your renter portal.</p><a class="button" href={`${base}account/#payments`}>Continue to Payments</a></main><Footer />
</BaseLayout>
<script>
  window.location.replace(`${import.meta.env.BASE_URL}account/${window.location.search}#payments`);
</script>
