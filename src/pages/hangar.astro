---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout
  title="Hutzell’s Hanger | Hutzell Aviation"
  description="An unlisted Hutzell Aviation arcade experience."
  noindex={true}
>
  <main class="hanger-page" data-hanger-page>
    <iframe
      class="game-frame"
      data-game-frame
      src={`${base}hutzellflash/`}
      title="Hutzell’s Hanger arcade game"
      allow="autoplay; fullscreen"
      loading="eager"
      tabindex="-1"
    ></iframe>

    <section class="screen lobby-screen" data-lobby-screen aria-labelledby="hanger-title">
      <a class="exit-link" href={base} aria-label="Return to Hutzell Aviation">← EXIT HANGER</a>
      <div class="screen-inner">
        <header class="arcade-heading">
          <p class="eyebrow">TIE-DOWN #10 // UNLISTED</p>
          <h1 id="hanger-title">HUTZELL’S HANGER</h1>
          <p class="tagline">Fly clean. Build combos. Earn your place among the top pilots.</p>
        </header>

        <section class="leaderboard" aria-labelledby="leaderboard-title">
          <div class="leaderboard-heading">
            <h2 id="leaderboard-title">TOP PILOTS</h2>
            <span data-board-state>SYNCING</span>
          </div>
          <div class="leaderboard-labels" aria-hidden="true">
            <span>RANK</span><span>PILOT</span><span>SCORE</span>
          </div>
          <ol class="leaderboard-list" data-leaderboard-list aria-live="polite"></ol>
        </section>

        <div class="lobby-actions">
          <p class="lobby-status" data-lobby-status aria-live="polite">Loading flight systems...</p>
          <button class="arcade-button" type="button" data-start-flight disabled>START FLIGHT</button>
        </div>
      </div>
    </section>

    <section class="screen result-screen is-hidden" data-result-screen aria-labelledby="result-title">
      <a class="exit-link" href={base} aria-label="Return to Hutzell Aviation">← EXIT HANGER</a>
      <div class="screen-inner result-inner">
        <header class="arcade-heading result-heading">
          <p class="eyebrow" data-result-kicker>FLIGHT COMPLETE</p>
          <h2 id="result-title" data-result-title>RUN COMPLETE</h2>
          <p class="result-score"><span>SCORE</span> <strong data-result-score>0</strong></p>
          <p class="tagline" data-result-message></p>
        </header>

        <section class="leaderboard" aria-labelledby="result-board-title">
          <div class="leaderboard-heading">
            <h3 id="result-board-title">TOP PILOTS</h3>
            <span data-result-board-state>LIVE</span>
          </div>
          <div class="leaderboard-labels" aria-hidden="true">
            <span>RANK</span><span>PILOT</span><span>SCORE</span>
          </div>
          <ol class="leaderboard-list" data-result-leaderboard-list aria-live="polite"></ol>
        </section>

        <div class="result-actions">
          <button class="arcade-button" type="button" data-fly-again>FLY AGAIN</button>
        </div>
      </div>
    </section>

    <section class="screen initials-screen is-hidden" data-initials-screen aria-labelledby="initials-title">
      <div class="initials-inner">
        <p class="eyebrow">TOP 10 QUALIFIER</p>
        <h2 id="initials-title">ENTER PILOT ID</h2>
        <p class="qualifying-score">SCORE <strong data-entry-score>0</strong></p>
        <p class="tagline">Claim your place with exactly 3 letters or numbers.</p>
        <form class="initials-form" data-score-form>
          <label for="pilot-initials">PILOT ID</label>
          <input
            id="pilot-initials"
            name="initials"
            inputmode="text"
            autocomplete="off"
            autocapitalize="characters"
            spellcheck="false"
            maxlength="3"
            minlength="3"
            pattern="[A-Za-z0-9]{3}"
            placeholder="ACE"
            required
          />
          <p class="entry-status" data-entry-status aria-live="polite"></p>
          <div class="initials-actions">
            <button class="arcade-button" type="submit" data-submit-score>POST SCORE</button>
            <button class="text-button" type="button" data-skip-score>SKIP</button>
          </div>
        </form>
      </div>
    </section>

    <section class="orientation-screen" data-orientation-screen aria-hidden="true">
      <div class="phone-icon" aria-hidden="true"><span></span></div>
      <p class="eyebrow">HUTZELL’S HANGER</p>
      <h2>ROTATE TO FLY</h2>
      <p>Turn your phone sideways to view the leaderboard and enter Tie-down #10.</p>
    </section>
  </main>
</BaseLayout>

<script>
  import { supabase } from '../lib/supabase';

  const gameFrame = document.querySelector('[data-game-frame]');
  const lobbyScreen = document.querySelector('[data-lobby-screen]');
  const resultScreen = document.querySelector('[data-result-screen]');
  const initialsScreen = document.querySelector('[data-initials-screen]');
  const orientationScreen = document.querySelector('[data-orientation-screen]');
  const lobbyList = document.querySelector('[data-leaderboard-list]');
  const resultList = document.querySelector('[data-result-leaderboard-list]');
  const boardState = document.querySelector('[data-board-state]');
  const resultBoardState = document.querySelector('[data-result-board-state]');
  const lobbyStatus = document.querySelector('[data-lobby-status]');
  const startButton = document.querySelector('[data-start-flight]');
  const flyAgainButton = document.querySelector('[data-fly-again]');
  const resultKicker = document.querySelector('[data-result-kicker]');
  const resultTitle = document.querySelector('[data-result-title]');
  const resultScore = document.querySelector('[data-result-score]');
  const resultMessage = document.querySelector('[data-result-message]');
  const scoreForm = document.querySelector('[data-score-form]');
  const initialsInput = document.querySelector('#pilot-initials');
  const entryScore = document.querySelector('[data-entry-score]');
  const entryStatus = document.querySelector('[data-entry-status]');
  const submitButton = document.querySelector('[data-submit-score]');
  const skipButton = document.querySelector('[data-skip-score]');
  const formatter = new Intl.NumberFormat('en-US');

  let leaderboard = [];
  let leaderboardReady = false;
  let leaderboardAttempted = false;
  let gameReady = false;
  let currentView = 'lobby';
  let runStartPromise = null;
  let pendingRunId = null;
  let pendingScore = 0;
  let pendingRunSeconds = 0;
  let startRequested = false;
  let startAttemptTimer = null;
  let startFailureTimer = null;

  function renderLeaderboard(target) {
    if (!target) return;
    target.replaceChildren();
    for (let index = 0; index < 10; index += 1) {
      const row = leaderboard[index];
      const item = document.createElement('li');
      const rank = document.createElement('span');
      const name = document.createElement('strong');
      const score = document.createElement('span');
      rank.textContent = String(index + 1).padStart(2, '0');
      name.textContent = row ? row.initials : '---';
      score.textContent = row ? formatter.format(row.score) : '------';
      item.append(rank, name, score);
      target.append(item);
    }
  }

  function renderAllLeaderboards() {
    renderLeaderboard(lobbyList);
    renderLeaderboard(resultList);
  }

  function postLeaderboardToGame() {
    if (!gameFrame?.contentWindow) return;
    gameFrame.contentWindow.postMessage({
      type: 'hutzellflash:leaderboard',
      scores: leaderboard.map((row) => row.score),
    }, window.location.origin);
  }

  function releaseGame() {
    gameFrame?.contentWindow?.postMessage({ type: 'hutzellflash:release' }, window.location.origin);
  }

  function updateStartAvailability() {
    startButton.disabled = !(gameReady && leaderboardAttempted);
    if (!gameReady) {
      lobbyStatus.textContent = 'Loading flight systems...';
    } else if (!leaderboardAttempted) {
      lobbyStatus.textContent = 'Syncing the global leaderboard...';
    } else if (!leaderboardReady) {
      lobbyStatus.textContent = 'Leaderboard offline. You can still fly, but scores cannot be posted.';
    } else if (leaderboard.length < 10) {
      lobbyStatus.textContent = `${10 - leaderboard.length} Top 10 spot${10 - leaderboard.length === 1 ? '' : 's'} still open.`;
    } else {
      lobbyStatus.textContent = `Beat ${formatter.format(leaderboard[9].score)} to enter the Top 10.`;
    }
  }

  async function loadLeaderboard() {
    boardState.textContent = 'SYNCING';
    resultBoardState.textContent = 'SYNCING';
    const { data, error } = await supabase.rpc('get_hutzellflash_leaderboard');
    leaderboardAttempted = true;

    if (error) {
      leaderboardReady = false;
      leaderboard = [];
      renderAllLeaderboards();
      boardState.textContent = 'OFFLINE';
      resultBoardState.textContent = 'OFFLINE';
      updateStartAvailability();
      return false;
    }

    leaderboard = (data || []).map((row) => ({
      rank: Number(row.leaderboard_rank),
      initials: String(row.initials || '---').toUpperCase(),
      score: Number(row.score) || 0,
    }));
    leaderboardReady = true;
    renderAllLeaderboards();
    postLeaderboardToGame();
    const stateText = leaderboard.length < 10 ? `${leaderboard.length}/10` : 'LIVE';
    boardState.textContent = stateText;
    resultBoardState.textContent = stateText;
    updateStartAvailability();
    return true;
  }

  async function startTrackedRun() {
    const { data, error } = await supabase.rpc('start_hutzellflash_run');
    if (error) return null;
    return data;
  }

  function qualifiesForTopTen(score) {
    if (!leaderboardReady) return false;
    if (leaderboard.length < 10) return true;
    return score > leaderboard[9].score;
  }

  function setView(view) {
    currentView = view;
    lobbyScreen.classList.toggle('is-hidden', view !== 'lobby');
    resultScreen.classList.toggle('is-hidden', view !== 'result');
    initialsScreen.classList.toggle('is-hidden', view !== 'initials');
    checkOrientation();
  }

  function clearStartTimers() {
    if (startAttemptTimer) window.clearTimeout(startAttemptTimer);
    if (startFailureTimer) window.clearTimeout(startFailureTimer);
    startAttemptTimer = null;
    startFailureTimer = null;
  }

  function dispatchStartGesture() {
    if (!gameFrame?.contentWindow || !gameFrame.contentDocument) return false;
    const frameWindow = gameFrame.contentWindow;
    const frameDocument = gameFrame.contentDocument;
    const canvas = frameDocument.getElementById('game');
    let attempted = false;

    // Primary path: call the existing game's public start function directly.
    try {
      if (typeof frameWindow.start === 'function') {
        frameWindow.focus();
        frameWindow.start();
        attempted = true;
      }
    } catch (error) { /* try the fallbacks below */ }

    // Safari can expose classic-script globals inconsistently inside an iframe.
    // Evaluating in the child realm reaches the same existing start() function
    // without changing the game files.
    if (!attempted) {
      try {
        frameWindow.eval('typeof start === "function" && start()');
        attempted = true;
      } catch (error) { /* try a synthetic pointer gesture */ }
    }

    // Final fallback mirrors the game's own mobile canvas input path. The game
    // listens for pointerdown on its canvas and does not require a trusted event.
    if (!attempted && canvas) {
      try {
        const rect = canvas.getBoundingClientRect();
        const eventInit = {
          bubbles: true,
          cancelable: true,
          clientX: rect.left + rect.width / 2,
          clientY: rect.top + rect.height / 2,
          pointerId: 1,
          pointerType: 'touch',
          isPrimary: true,
        };
        if (typeof frameWindow.PointerEvent === 'function') {
          canvas.dispatchEvent(new frameWindow.PointerEvent('pointerdown', eventInit));
          frameWindow.dispatchEvent(new frameWindow.PointerEvent('pointerup', eventInit));
        } else {
          canvas.dispatchEvent(new frameWindow.MouseEvent('mousedown', eventInit));
          canvas.dispatchEvent(new frameWindow.MouseEvent('mouseup', eventInit));
        }
        frameWindow.focus();
        attempted = true;
      } catch (error) { /* the acknowledgement timeout handles failure */ }
    }

    return attempted;
  }

  function attemptGameStart() {
    if (!startRequested) return;
    dispatchStartGesture();
    // Keep the lobby covering the iframe until the game itself confirms that
    // a run actually started. This prevents the game's title/high-score screen
    // from flashing full-screen on mobile when a start gesture is missed.
    startAttemptTimer = window.setTimeout(() => {
      if (startRequested) dispatchStartGesture();
    }, 180);
  }

  function beginFlight() {
    if (!gameReady || startRequested) return;
    pendingRunId = null;
    pendingScore = 0;
    pendingRunSeconds = 0;
    clearStartTimers();
    startRequested = true;
    startButton.disabled = true;
    flyAgainButton.disabled = true;
    if (currentView === 'lobby') lobbyStatus.textContent = 'Starting flight...';

    requestAnimationFrame(attemptGameStart);
    startFailureTimer = window.setTimeout(() => {
      if (!startRequested) return;
      startRequested = false;
      clearStartTimers();
      startButton.disabled = false;
      flyAgainButton.disabled = false;
      if (currentView !== 'lobby') setView('lobby');
      lobbyStatus.textContent = 'Flight controls did not respond. Tap START FLIGHT again.';
    }, 1600);
  }

  function showResult({ score, title, kicker, message }) {
    resultScore.textContent = formatter.format(score);
    resultTitle.textContent = title;
    resultKicker.textContent = kicker;
    resultMessage.textContent = message;
    setView('result');
  }

  function openInitials(score, runId, runSeconds) {
    pendingScore = score;
    pendingRunId = runId;
    pendingRunSeconds = runSeconds;
    entryScore.textContent = formatter.format(score);
    entryStatus.textContent = '';
    initialsInput.value = '';
    submitButton.disabled = false;
    skipButton.disabled = false;
    setView('initials');
    window.setTimeout(() => initialsInput.focus(), 80);
  }

  async function handleGameOver(payload) {
    const score = Math.max(0, Math.floor(Number(payload.score) || 0));
    const runSeconds = Math.max(1, Math.floor(Number(payload.runSeconds) || 1));
    releaseGame();

    const runId = await Promise.resolve(runStartPromise).catch(() => null);
    await loadLeaderboard();

    if (!leaderboardReady) {
      showResult({
        score,
        title: 'RUN COMPLETE',
        kicker: 'FLIGHT COMPLETE',
        message: 'The global board is offline, so this score cannot be posted yet.',
      });
      return;
    }

    if (!qualifiesForTopTen(score)) {
      const cutoff = leaderboard[9]?.score || 0;
      showResult({
        score,
        title: 'RUN COMPLETE',
        kicker: 'FLIGHT COMPLETE',
        message: `Top 10 cutoff: ${formatter.format(cutoff)}.`,
      });
      return;
    }

    if (!runId) {
      showResult({
        score,
        title: 'TOP 10 SCORE',
        kicker: 'QUALIFIED // NOT POSTED',
        message: 'This run was not tracked by Supabase, so it cannot be posted.',
      });
      return;
    }

    openInitials(score, runId, runSeconds);
  }

  function isPhoneLike() {
    const coarse = window.matchMedia('(pointer: coarse)').matches || navigator.maxTouchPoints > 0;
    const shortSide = Math.min(window.screen?.width || window.innerWidth, window.screen?.height || window.innerHeight);
    return coarse && shortSide < 700;
  }

  function checkOrientation() {
    const shouldRotate = isPhoneLike() && window.innerHeight > window.innerWidth && currentView !== 'play';
    orientationScreen.classList.toggle('is-visible', shouldRotate);
    orientationScreen.setAttribute('aria-hidden', shouldRotate ? 'false' : 'true');
  }

  window.addEventListener('resize', checkOrientation);
  window.addEventListener('orientationchange', checkOrientation);

  window.addEventListener('message', async (event) => {
    if (event.origin !== window.location.origin || event.source !== gameFrame?.contentWindow) return;
    const payload = event.data || {};
    if (payload.type === 'hutzellflash:run-start') {
      clearStartTimers();
      startRequested = false;
      startButton.disabled = false;
      flyAgainButton.disabled = false;
      runStartPromise = startTrackedRun();
      setView('play');
      gameFrame?.contentWindow?.focus();
    }
    if (payload.type === 'hutzellflash:game-over') {
      await handleGameOver(payload);
    }
  });

  gameFrame.addEventListener('load', () => {
    gameReady = true;
    postLeaderboardToGame();
    updateStartAvailability();
  });

  startButton.addEventListener('click', beginFlight);
  flyAgainButton.addEventListener('click', beginFlight);

  initialsInput.addEventListener('input', () => {
    initialsInput.value = initialsInput.value.toUpperCase().replace(/[^A-Z0-9]/g, '').slice(0, 3);
  });

  scoreForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    const initials = initialsInput.value.toUpperCase().replace(/[^A-Z0-9]/g, '').slice(0, 3);

    if (!/^[A-Z0-9]{3}$/.test(initials)) {
      entryStatus.textContent = 'Enter exactly 3 letters or numbers.';
      return;
    }
    if (!pendingRunId) {
      entryStatus.textContent = 'This run is missing its server token.';
      return;
    }

    submitButton.disabled = true;
    skipButton.disabled = true;
    entryStatus.textContent = 'Checking the live board...';

    const { data, error } = await supabase.rpc('submit_hutzellflash_score', {
      p_run_id: pendingRunId,
      p_initials: initials,
      p_score: pendingScore,
      p_run_seconds: pendingRunSeconds,
    });

    if (error) {
      entryStatus.textContent = error.message || 'Score could not be posted.';
      submitButton.disabled = false;
      skipButton.disabled = false;
      return;
    }

    const result = Array.isArray(data) ? data[0] : data;
    if (!result?.accepted) {
      await loadLeaderboard();
      showResult({
        score: pendingScore,
        title: 'BOARD CHANGED',
        kicker: 'SCORE NOT POSTED',
        message: result?.message || 'The live Top 10 changed before your score was submitted.',
      });
      pendingRunId = null;
      return;
    }

    const rank = Number(result.leaderboard_rank) || 0;
    await loadLeaderboard();
    showResult({
      score: pendingScore,
      title: `YOU’RE #${rank}`,
      kicker: `${initials} // SCORE POSTED`,
      message: 'Your pilot ID is now on the global Top 10.',
    });
    pendingRunId = null;
  });

  skipButton.addEventListener('click', async () => {
    const score = pendingScore;
    pendingRunId = null;
    await loadLeaderboard();
    showResult({
      score,
      title: 'RUN COMPLETE',
      kicker: 'SCORE NOT POSTED',
      message: 'Your qualifying score was not submitted.',
    });
  });

  renderAllLeaderboards();
  updateStartAvailability();
  checkOrientation();
  loadLeaderboard();
</script>

<style>
  :global(html), :global(body) {
    width: 100%;
    height: 100%;
    margin: 0;
    overflow: hidden;
    overscroll-behavior: none;
    background: #0e1420;
  }

  :global(html) { -webkit-text-size-adjust: 100%; text-size-adjust: 100%; }
  :global(body) { touch-action: manipulation; }
  :global(*) { box-sizing: border-box; }

  .hanger-page {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    background: #0e1420;
    color: #eef7fb;
    font-family: "Courier New", ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  .game-frame {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    background: #0e1420;
    transform: translateZ(0);
    -webkit-transform: translateZ(0);
  }

  .screen,
  .orientation-screen {
    position: absolute;
    inset: 0;
  }

  .screen {
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding:
      max(18px, env(safe-area-inset-top))
      max(22px, env(safe-area-inset-right))
      max(18px, env(safe-area-inset-bottom))
      max(22px, env(safe-area-inset-left));
    background:
      radial-gradient(circle at 50% -12%, rgba(54, 134, 176, .32), transparent 42%),
      linear-gradient(180deg, rgba(5, 19, 31, .985), rgba(7, 28, 43, .985) 54%, rgba(4, 16, 25, .99));
    transition: opacity 150ms ease;
  }

  .screen.is-hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .screen-inner {
    width: min(760px, 92vw);
    max-height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .exit-link {
    position: absolute;
    top: max(16px, env(safe-area-inset-top));
    left: max(18px, env(safe-area-inset-left));
    z-index: 2;
    color: #789bad;
    text-decoration: none;
    font-size: clamp(.58rem, 1.2vw, .72rem);
    font-weight: 900;
    letter-spacing: .13em;
  }

  .exit-link:hover,
  .exit-link:focus-visible { color: #8bdcff; }

  .arcade-heading { text-align: center; }
  .eyebrow {
    margin: 0 0 7px;
    color: #ffd866;
    font-size: clamp(.58rem, 1.4vw, .72rem);
    font-weight: 900;
    letter-spacing: .2em;
  }

  .arcade-heading h1,
  .arcade-heading h2,
  .initials-inner h2 {
    margin: 0;
    color: #fff;
    font-family: inherit;
    font-weight: 900;
    line-height: .92;
    letter-spacing: -.055em;
    text-shadow: 0 4px 0 rgba(0, 0, 0, .24);
  }

  .arcade-heading h1 { font-size: clamp(2.35rem, 7vh, 5rem); }
  .arcade-heading h2,
  .initials-inner h2 { font-size: clamp(2rem, 6vh, 4.2rem); }

  .tagline {
    margin: 10px auto 0;
    max-width: 650px;
    color: #9fb9c7;
    font-size: clamp(.7rem, 1.8vh, .9rem);
    line-height: 1.45;
  }

  .leaderboard {
    width: min(660px, 100%);
    margin: clamp(12px, 2.5vh, 24px) auto 0;
  }

  .leaderboard-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 14px;
    padding-bottom: 6px;
    border-bottom: 1px solid rgba(139, 220, 255, .24);
  }

  .leaderboard-heading h2,
  .leaderboard-heading h3 {
    margin: 0;
    color: #fff;
    font-family: inherit;
    font-size: clamp(1rem, 3vh, 1.45rem);
    letter-spacing: .08em;
  }

  .leaderboard-heading > span {
    color: #8bdcff;
    font-size: .6rem;
    font-weight: 900;
    letter-spacing: .14em;
  }

  .leaderboard-labels,
  .leaderboard-list li {
    display: grid;
    grid-template-columns: 60px 1fr minmax(100px, auto);
    align-items: center;
    gap: 16px;
  }

  .leaderboard-labels {
    padding: 5px 4px 3px;
    color: #4f7487;
    font-size: .54rem;
    font-weight: 900;
    letter-spacing: .13em;
  }

  .leaderboard-labels span:last-child { text-align: right; }

  .leaderboard-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .leaderboard-list li {
    min-height: clamp(23px, 4.7vh, 35px);
    padding: 0 4px;
    border-top: 1px solid rgba(255, 255, 255, .055);
    color: #dcecff;
    font-size: clamp(.66rem, 1.85vh, .88rem);
    font-variant-numeric: tabular-nums;
  }

  .leaderboard-list li > span:first-child {
    color: #587889;
    font-size: .72em;
  }

  .leaderboard-list strong {
    color: #fff;
    letter-spacing: .19em;
  }

  .leaderboard-list li:nth-child(-n+3) strong,
  .leaderboard-list li:nth-child(-n+3) > span:last-child { color: #ffd866; }
  .leaderboard-list li > span:last-child {
    color: #8bdcff;
    font-weight: 900;
    text-align: right;
  }

  .lobby-actions,
  .result-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    margin-top: clamp(9px, 2vh, 18px);
  }

  .lobby-status {
    min-height: 17px;
    margin: 0;
    color: #7395a7;
    text-align: center;
    font-size: clamp(.58rem, 1.5vh, .72rem);
    line-height: 1.35;
