---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import '../styles/global.css';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Renter Portal | Hutzell Aviation" description="Approved Hutzell Aviation renters can purchase block hours and manage rental activity from the renter portal.">
  <Header />
  <main>
    <section class="section checkout-section">
      <div class="container">
        <div class="checkout-form-card payment-roadmap">
          <Icon name="dollar" size={34}/>
          <h1>Rental purchases have moved to the renter portal.</h1>
          <p>Approved renters can purchase 15-, 25-, or 50-hour blocks and manage their account from one place.</p>
          <div class="account-actions"><a class="button" href={`${base}account/#purchase-hours`}>Open Renter Portal</a></div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
<script>
  const base = import.meta.env.BASE_URL;
  window.location.replace(`${base}account/#purchase-hours`);
</script>
