---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import '../styles/global.css';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Renter Account | Hutzell Aviation" description="Hutzell Aviation renter account and reservation dashboard preview.">
  <Header />
  <main class="account-main">
    <section class="account-login-section">
      <div class="container account-login-grid">
        <div class="account-intro reveal"><p class="eyebrow light"><span></span> RENTER PORTAL</p><h1>Reservations and hour balances in one place.</h1><p>This page is the front-end preview for approved-renter authentication. Supabase Auth will be connected in the backend phase.</p><ul><li><Icon name="calendar" size={20}/> Upcoming and past reservations</li><li><Icon name="clock" size={20}/> Prepaid hour balance and ledger</li><li><Icon name="document" size={20}/> Receipts, approval status, and documents</li></ul></div>
        <div class="login-card reveal reveal-delay"><div class="login-logo"><img src={`${base}images/logo-full.png`} alt="Hutzell Aviation" width="250" height="165"/></div><h2>Renter sign in</h2><p>Authentication is not active in this static prototype.</p><label>Email address<input type="email" placeholder="pilot@example.com" disabled/></label><label>Password<input type="password" value="prototype" disabled/></label><button class="button is-disabled" type="button" disabled>Sign In</button><span class="login-divider">or</span><a class="button button-outline" href={`${base}apply/`}>Apply to Become a Renter</a><small>Backend milestone: Supabase authentication, role-based access, and renter approval status.</small></div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
