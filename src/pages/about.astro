---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import CallToAction from '../components/CallToAction.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import '../styles/global.css';
const base = import.meta.env.BASE_URL;
const photo = (name: string) => `${base}images/${name}`;
---
<BaseLayout title="About Tyler | Hutzell Aviation" description="Learn about Tyler Hutzell, his flight training, certificates, ratings, and the purpose behind Hutzell Aviation aircraft rental at KWDR in Winder, Georgia.">
  <Header />
  <main>
    <PageHero eyebrow="ABOUT HUTZELL AVIATION" title="Built by a pilot, for pilots who need access." description="Tyler Hutzell founded Hutzell Aviation to provide qualified pilots with clear, professional access to a Piper PA-28-140 at KWDR in Winder." />

    <section class="section">
      <div class="container biography-grid">
        <div class="bio-visual reveal">
          <figure class="portrait-photo"><img src={photo("tyler-hutzell-portrait.jpg")} alt="Tyler Hutzell, founder of Hutzell Aviation, standing in front of N8491F" width="1024" height="1536" decoding="async" /><figcaption><span>Tyler Hutzell</span><small>Founder, Hutzell Aviation LLC</small></figcaption></figure>
          <div class="bio-credential"><Icon name="plane" size={25} /><div><strong>ATP Flight School graduate</strong><span>Completed February 2026 at KLZU</span></div></div>
        </div>
        <div class="bio-copy reveal reveal-delay">
          <p class="eyebrow"><span></span> MEET THE OWNER</p>
          <h2>{site.owner}</h2>
          <p class="lead">Tyler completed ATP Flight School at Gwinnett County Airport (KLZU) in February 2026 and has 235.5 total flight hours.</p>
          <p>He holds a Private Pilot certificate, instrument rating, Commercial Single-Engine Land and Multi-Engine Land certificates, and a CFII certificate. That training shapes a renter experience built around clear expectations, aircraft familiarity, and responsible access.</p>
          <p>Hutzell Aviation is an aircraft-rental company—not a flight school. Its purpose is to give qualified pilots a professional way to review availability, choose a wet rental rate, and build time in a 1974 Piper PA-28-140 based at KWDR.</p>
          <div class="bio-values"><div><Icon name="shield" size={22} /><span><strong>Responsible access</strong>Approval and policies before booking.</span></div><div><Icon name="calendar" size={22} /><span><strong>Clear scheduling</strong>Availability that renters can understand.</span></div><div><Icon name="gauge" size={22} /><span><strong>Time-builder focused</strong>Packages designed around consistent flying.</span></div></div>
        </div>
      </div>
    </section>

    <section class="section purpose-section">
      <div class="container">
        <div class="section-heading centered reveal"><p class="eyebrow centered-eyebrow light"><span></span> THE COMPANY PURPOSE <span></span></p><h2>Aircraft access built around responsible rental.</h2><p>Hutzell Aviation combines transparent requirements, personal approval, and flexible wet-rate options for qualified renters.</p></div>
        <div class="purpose-grid"><article class="reveal"><span>01</span><h3>Dependable access</h3><p>Build a professional reservation process around one well-presented aircraft.</p></article><article class="reveal reveal-1"><span>02</span><h3>Transparent expectations</h3><p>Publish qualifications, policies, pricing terms, and aircraft information clearly.</p></article><article class="reveal reveal-2"><span>03</span><h3>Flexible time building</h3><p>Support both occasional renters and pilots purchasing larger hour blocks.</p></article></div>
      </div>
    </section>

    <section class="section gallery-section">
      <div class="container">
        <div class="section-heading reveal"><p class="eyebrow"><span></span> PHOTO GALLERY</p><h2>Meet Tyler and the aircraft.</h2><p>Take a look at Tyler Hutzell and the actual Piper Cherokee N8491F on the ramp.</p></div>
        <div class="gallery-grid">
          <figure class="gallery-photo wide founder-gallery-feature"><img src={photo("tyler-hutzell-airport.jpg")} alt="Tyler Hutzell standing in front of Hutzell Aviation's red-and-white Piper Cherokee" width="1024" height="1536" loading="lazy" decoding="async" /><figcaption>Tyler Hutzell · Founder</figcaption></figure>
          <figure class="gallery-photo"><img src={photo("n8491f-front-quarter.jpg")} alt="Front three-quarter view of the Piper Cherokee N8491F parked on the airport ramp" width="1536" height="1024" loading="lazy" decoding="async" /><figcaption>The Cherokee at KWDR</figcaption></figure>
          <figure class="gallery-photo"><img src={photo("n8491f-side-profile.jpg")} alt="Side view of N8491F, showing the Piper Cherokee fuselage, wings, and distinctive registration" width="1536" height="1024" loading="lazy" decoding="async" /><figcaption>Aircraft side profile</figcaption></figure>
          <figure class="gallery-photo"><img src={photo("n8491f-rear-quarter.jpg")} alt="N8491F photographed from behind with the tail and red-and-white paint visible" width="1536" height="1024" loading="lazy" decoding="async" /><figcaption>Rear three-quarter view</figcaption></figure>
          <figure class="gallery-photo"><img src={photo("n8491f-hero.jpg")} alt="N8491F front three-quarter view showing the wings, nose, and landing gear" width="1536" height="1024" loading="lazy" decoding="async" /><figcaption>Ready for the next flight</figcaption></figure>
        </div>
      </div>
    </section>

    <CallToAction />
  </main>
  <Footer />
</BaseLayout>
