---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import CallToAction from '../components/CallToAction.astro';
import Icon from '../components/Icon.astro';
import { aircraftSpecs } from '../data/site';
import '../styles/global.css';
const aircraftExterior = 'https://upload.wikimedia.org/wikipedia/commons/8/8b/Piper_PA-28_Cherokee_-_G-BCPG_-_2_October_2025.jpg';
const aircraftCockpit = 'https://upload.wikimedia.org/wikipedia/commons/2/29/Cockpit_of_Piper_PA-28-151_%28G-BOYH%29_at_Bristol_Airport%2C_England_15May2016_arp.jpg';
const aircraftLanding = 'https://upload.wikimedia.org/wikipedia/commons/2/24/Piper_PA-28_Cherokee_Landing_03.JPG';
---
<BaseLayout title="Piper Cherokee Rental Aircraft | Hutzell Aviation" description="Explore the Piper Cherokee planned for Hutzell Aviation aircraft rental and pilot time building in the Athens, Georgia area.">
  <Header />
  <main>
    <PageHero eyebrow="THE AIRCRAFT" title="Piper Cherokee" description="A familiar single-engine platform being prepared for approved renters, local flying, and pilot time building." />

    <section class="section aircraft-detail-section">
      <div class="container aircraft-detail-grid">
        <figure class="aircraft-showcase reveal">
          <div class="aircraft-showcase-head"><span>PIPER CHEROKEE</span><span class="draft-pill">Representative photo</span></div>
          <img class="aircraft-showcase-photo" src={aircraftExterior} alt="Representative Piper PA-28 Cherokee parked on an airfield" width="4259" height="2842" decoding="async" />
          <figcaption>Filler photography of a Piper PA-28 Cherokee. Replace this image with the actual Hutzell Aviation aircraft when those photos are available.</figcaption>
        </figure>
        <div class="aircraft-detail-copy reveal reveal-delay"><p class="eyebrow"><span></span> RENTAL PLATFORM</p><h2>Aircraft details renters need before they apply.</h2><p class="lead">This page separates confirmed facts from placeholders so the site does not accidentally publish incorrect aircraft specifications.</p><div class="spec-grid">{aircraftSpecs.map((spec) => <div><span>{spec.label}</span><strong>{spec.value}</strong></div>)}</div></div>
      </div>
    </section>

    <section class="section requirements-section">
      <div class="container requirements-grid">
        <div class="section-heading reveal"><p class="eyebrow light"><span></span> RENTER REQUIREMENTS</p><h2>Approval before access.</h2><p>Final requirements must follow the aircraft insurance policy and Tyler’s rental agreement. The site is ready for those exact rules once confirmed.</p></div>
        <div class="requirement-cards"><article class="reveal"><Icon name="document" size={26} /><h3>Pilot documentation</h3><p>Certificate, medical or BasicMed information when applicable, recent experience, and other insurer-required records.</p></article><article class="reveal reveal-1"><Icon name="shield" size={26} /><h3>Renter approval</h3><p>Tyler reviews each application before the renter can reserve the aircraft online.</p></article><article class="reveal reveal-2"><Icon name="plane" size={26} /><h3>Aircraft checkout</h3><p>A familiarization or checkout requirement can be tracked before booking privileges are activated.</p></article></div>
      </div>
    </section>

    <section class="section operations-section">
      <div class="container">
        <div class="section-heading centered reveal"><p class="eyebrow centered-eyebrow"><span></span> OPERATING INFORMATION <span></span></p><h2>Policies the final aircraft page will publish.</h2></div>
        <div class="operations-grid"><div><span>01</span><h3>Home airport</h3><p>Aircraft location, access instructions, and normal operating hours.</p></div><div><span>02</span><h3>Fuel policy</h3><p>Wet or dry rate, reimbursement process, and required fuel level on return.</p></div><div><span>03</span><h3>Overnight use</h3><p>Approval process, daily minimums, and return-time expectations.</p></div><div><span>04</span><h3>Squawk reporting</h3><p>A clear process for reporting maintenance or operational concerns.</p></div></div>
      </div>
    </section>

    <section class="section gallery-section">
      <div class="container">
        <div class="section-heading reveal"><p class="eyebrow"><span></span> AIRCRAFT GALLERY</p><h2>Representative Piper Cherokee photography.</h2><p>These public-domain filler images show the type of photography the finished page needs. They are not photos of the specific Hutzell Aviation aircraft.</p></div>
        <div class="gallery-grid">
          <figure class="gallery-photo wide"><img src={aircraftExterior} alt="Representative Piper PA-28 Cherokee exterior" width="4259" height="2842" loading="lazy" decoding="async" /><figcaption>Exterior profile</figcaption></figure>
          <figure class="gallery-photo"><img src={aircraftCockpit} alt="Representative Piper PA-28 cockpit" width="3852" height="2564" loading="lazy" decoding="async" /><figcaption>Panel and avionics</figcaption></figure>
          <figure class="gallery-photo"><img src={aircraftLanding} alt="Representative Piper PA-28 Cherokee landing" width="1600" height="1200" loading="lazy" decoding="async" /><figcaption>Aircraft in operation</figcaption></figure>
          <figure class="gallery-photo aircraft-detail-crop"><img src={aircraftExterior} alt="Representative Piper Cherokee fuselage and wing detail" width="4259" height="2842" loading="lazy" decoding="async" /><figcaption>Fuselage and wing detail</figcaption></figure>
          <figure class="gallery-photo cockpit-detail-crop"><img src={aircraftCockpit} alt="Representative Piper PA-28 instrument detail" width="3852" height="2564" loading="lazy" decoding="async" /><figcaption>Instrument detail</figcaption></figure>
        </div>
      </div>
    </section>

    <CallToAction title="Ready to review open time?" text="Check the public calendar, then apply to become an approved renter when the aircraft and policies are finalized." />
  </main>
  <Footer />
</BaseLayout>
